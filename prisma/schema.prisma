// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id             Int      @id @default(autoincrement())
  name           String
  email          String   @unique
  password       String
  country        String
  incomeBracket  String

  transactions   Transaction[]
  budgets        Budget[]
  taxEstimates   TaxEstimate[]
  reports        Report[]
}

model Transaction {
  id        Int      @id @default(autoincrement())
  type      String
  category  String
  amount    Float
  date      DateTime

  userId    Int
  user      User     @relation(fields: [userId], references: [id])
}

model Budget {
  id        Int      @id @default(autoincrement())
  category  String
  limit     Float
  month     String

  userId    Int
  user      User     @relation(fields: [userId], references: [id])
}

model TaxEstimate {
  id             Int      @id @default(autoincrement())
  quarter        String
  estimatedTax   Float

  userId         Int
  user           User     @relation(fields: [userId], references: [id])
}

model Report {
  id          Int      @id @default(autoincrement())
  period      String
  reportType  String
  filePath    String

  userId      Int
  user        User     @relation(fields: [userId], references: [id])
}