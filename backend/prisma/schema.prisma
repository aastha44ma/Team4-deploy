generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model budget {
  id          Int     @id @default(autoincrement())
  category    String
  limit       Float
  month       String
  userId      Int
  description String?
  user        user    @relation(fields: [userId], references: [id], map: "Budget_userId_fkey")

  @@unique([userId, category, month], map: "Budget_userId_category_month_key")
}

model category {
  id     Int    @id @default(autoincrement())
  name   String
  type   String
  userId Int
  user   user   @relation(fields: [userId], references: [id], map: "Category_userId_fkey")

  @@unique([userId, name, type], map: "Category_userId_name_type_key")
}

model report {
  id         Int    @id @default(autoincrement())
  period     String
  reportType String
  filePath   String
  userId     Int
  user       user   @relation(fields: [userId], references: [id], map: "Report_userId_fkey")

  @@index([userId], map: "Report_userId_fkey")
}

model taxestimate {
  id                      Int     @id @default(autoincrement())
  country                 String
  region                  String
  taxYear                 String
  taxRegime               String
  filingStatus            String
  quarter                 String
  annualIncome            Float
  grossIncome             Float
  businessExpenses        Float   @default(0)
  retirementContributions Float   @default(0)
  healthInsurance         Float   @default(0)
  homeOffice              Float   @default(0)
  taxableIncome           Float
  estimatedTax            Float
  effectiveTaxRate        Float
  userId                  Int

  user user @relation(fields: [userId], references: [id], map: "TaxEstimate_userId_fkey")

  @@index([userId], map: "TaxEstimate_userId_fkey")
}

model transaction {
  id       Int      @id @default(autoincrement())
  type     String
  category String
  amount   Float
  date     DateTime
  userId   Int
  user     user     @relation(fields: [userId], references: [id], map: "Transaction_userId_fkey")

  @@index([userId], map: "Transaction_userId_fkey")
}

model user {
  id            Int           @id @default(autoincrement())
  name          String
  email         String        @unique(map: "User_email_key")
  password      String
  country       String
  incomeBracket String
  budget        budget[]
  category      category[]
  report        report[]
  taxestimate   taxestimate[]
  transaction   transaction[]
}